# Session-only configuration. Never copy the service .env into a user's profile.
AGENT_MODE=session
# Same per-machine random 32-byte hex secret as the service. No default key exists.
AGENT_SESSION_RELAY_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
AGENT_SESSION_RELAY_PORT=47652
# Separate local outbox secret; retain this value when rotating the relay key.
AGENT_OFFLINE_CACHE_KEY=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_SECRET
# No RABBITMQ_URL, AGENT_AUTH_TOKEN, GitHub token or service cache key here.
# Linux enrollment: /etc/activity-monitor/sessions/<uid>/session.env, owned by user, 0600.
# Windows: restrict ACL to enrolled user, Administrators and SYSTEM.
# manage-session scripts pin the old cache secret before rotating legacy shared relay keys.
