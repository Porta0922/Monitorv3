# Deployment-specific values are required. Never ship real credentials in a package.
MONITOR_ENV=production
AGENT_MODE=service
AGENT_SERVER_URL=https://monitor.example.invalid
# Configure enrollment with scripts/configure-agent-identity.py before starting.
# AGENT_ENROLLMENT_CODE_FILE=absolute/path/to/private/enrollment.code
# SSL_CERT_FILE=absolute/path/to/trusted/ca.crt
# Production obtains per-credential AMQPS/HTTP access through enrollment.
# AGENT_AUTH_TOKEN and RABBITMQ_URL are legacy development settings only.
# Keep a stable cache key when upgrading; changing it prevents decoding queued events.
# Required in production: 32 random bytes as 64 hex characters.
# AGENT_OFFLINE_CACHE_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Optional absolute paths; service templates provide their own defaults.
# AGENT_DATA_DIR=...
# AGENT_LOG_DIR=...

# Optional local session relay; leave disabled until P4 validation.
AGENT_SESSION_RELAY_ENABLED=false
AGENT_SESSION_RELAY_PORT=47652
# AGENT_SESSION_RELAY_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Local status UI. Set an explicit token for administrative API access.
WEB_BIND=127.0.0.1:9876
# WEB_UI_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN
