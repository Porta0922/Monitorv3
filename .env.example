# ActivityMonitor Enterprise v3 - Environment Variables
# Copy this file to .env and fill in the values

# ==================== Server ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
DATABASE_URL=postgresql://monitor_user:monitor_password@localhost:5432/activity_monitor
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# JWT secret for dashboard authentication (CHANGE THIS IN PRODUCTION)
JWT_SECRET=change-me-in-production

# Admin credentials for dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ==================== Agent ====================
# Agent authentication token (must match server's expected value)
AGENT_AUTH_TOKEN=change-me-in-production

# Server URL for the agent to connect to
AGENT_SERVER_URL=http://localhost:3000

# RabbitMQ URL for the agent to publish events
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# GitHub token for auto-updates (optional, for private repos)
GITHUB_TOKEN=

# Offline cache encryption key
OFFLINE_CACHE_KEY=

# Web UI authentication token (auto-generated if not set)
WEB_UI_TOKEN=

# ==================== Agent Policy (optional overrides) ====================
# These override the agent's default intervals via remote policy
# AGENT_CONFIG_WINDOW_ACTIVITY_INTERVAL=5
# AGENT_CONFIG_HEARTBEAT_INTERVAL=60
# AGENT_CONFIG_USB_DETECTOR_INTERVAL=30
# AGENT_CONFIG_USB_COPY_INTERVAL=10
# AGENT_CONFIG_WIFI_INTERVAL=300
# AGENT_CONFIG_RUNNING_APPS_INTERVAL=10
# AGENT_CONFIG_INVENTORY_INTERVAL_DAYS=1
# AGENT_CONFIG_HEATMAP_INTERVAL=60
# AGENT_CONFIG_RESOURCE_LOGGER_INTERVAL=30
# AGENT_CONFIG_OSQUERY_SCHEDULER_SECONDS=300
# AGENT_CONFIG_IDLE_THRESHOLD=300
# AGENT_CONFIG_ACTIVITY_HEARTBEAT=60

# ==================== Agent OSQuery Policy ====================
# AGENT_OSQUERY_POLICY_PROFILE=standard
# AGENT_OSQUERY_POLICY_TICK_SECONDS=300

# ==================== Metrics retention ====================
# Complete UTC days of detailed data, then daily summaries.
METRICS_RAW_RETENTION_DAYS=14
METRICS_SUMMARY_RETENTION_DAYS=365
# Bounded batches, repeated automatically by the maintenance container.
MAINTENANCE_BATCH_SIZE=5000
MAINTENANCE_INTERVAL_SECONDS=300

# Stable RabbitMQ node identity. For an existing volume, preserve its original hostname.
RABBITMQ_HOSTNAME=rabbitmq

# Pending validation: leave history deletion disabled. Per-job 0 disables deletion.
HISTORY_RETENTION_ENABLED=false
ACTIVITY_RETENTION_DAYS=30
USB_RETENTION_DAYS=90
WIFI_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
RESOLVED_ALERT_RETENTION_DAYS=180

# Complete server policy snapshot; changes require server configuration reload/recreation.
AGENT_CONFIG_MONITORING_PAUSED=false
AGENT_CONFIG_ENABLED_MONITORS=
AGENT_CONFIG_DISABLED_MONITORS=
AGENT_CONFIG_WINDOW_ACTIVITY_INTERVAL=2
AGENT_CONFIG_HEARTBEAT_INTERVAL=60
AGENT_CONFIG_USB_DETECTOR_INTERVAL=60
AGENT_CONFIG_USB_COPY_INTERVAL=60
AGENT_CONFIG_WIFI_INTERVAL=120
AGENT_CONFIG_RUNNING_APPS_INTERVAL=60
AGENT_CONFIG_INVENTORY_INTERVAL_DAYS=1
AGENT_CONFIG_HEATMAP_INTERVAL=3600
AGENT_CONFIG_RESOURCE_LOGGER_INTERVAL=60
AGENT_CONFIG_OSQUERY_SCHEDULER_SECONDS=0
AGENT_CONFIG_IDLE_THRESHOLD=300
AGENT_CONFIG_ACTIVITY_HEARTBEAT=30

# Inventory change log only; current inventory and last successful scan are retained.
# Security cleanup is opt-in; active investigations protect their device/time range.
SECURITY_EVENT_RETENTION_DAYS=0
# Minimum 32 days: must outlive the fixed 30-day replay window.
DEDUPE_RETENTION_DAYS=32
INVENTORY_CHANGE_RETENTION_DAYS=90

# Multi-principal session detail; 0 disables this history job.
SESSION_EVENT_RETENTION_DAYS=30
