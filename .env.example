# ActivityMonitor Enterprise v3 - Environment Configuration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
SERVER_ENV=development

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://monitor_user:monitor_password@localhost:5432/activity_monitor

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=monitoring
RABBITMQ_QUEUE=activity_logs

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# Agent Configuration
AGENT_DEVICE_ID=auto-generate
AGENT_OFFLINE_CACHE_PATH=/var/lib/activity-monitor/cache.db
AGENT_OFFLINE_CACHE_KEY=change-this-encryption-key-in-production
AGENT_SERVER_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
ENABLE_HTTPS=false
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem

# Features
ENABLE_USB_DETECTION=false
ENABLE_AUTO_UPDATE=false
MAINTENANCE_WORKER_ENABLED=false
