[Unit]
Description=Monitor health, queue and suspicious-activity detector
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/monitor/scripts/production/watch_health.py --project monitor-production-candidate --backup-dir /var/backups/monitor
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=monitor-watchdog
StateDirectoryMode=0700
# Do not add OnFailure: the watchdog handles transitions, retries and cooldown.
